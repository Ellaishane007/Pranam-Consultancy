# Server
NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000

# Session / CSRF (use a long random string in production)
SESSION_SECRET=replace-with-a-long-random-secret

# MongoDB — leave empty to store submissions as local JSON files
MONGODB_URI=

# Optional contact placeholders (leave blank until verified)
CONTACT_PHONE=
CONTACT_EMAIL=
CONTACT_ADDRESS=
BUSINESS_HOURS=
LINKEDIN_URL=
INSTAGRAM_URL=

# Optional Google Maps embed URL (iframe src)
GOOGLE_MAPS_EMBED_URL=

# Email adapter (disabled by default)
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Uploads
MAX_RESUME_MB=5
