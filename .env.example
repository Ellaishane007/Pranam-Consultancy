# Server
NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000
# Set to the number of trusted reverse-proxy hops in production.
TRUST_PROXY=0

# Session / CSRF (use a long random string in production)
SESSION_SECRET=dev-only-change-me

# MongoDB — required in production; local JSON storage is for development only
MONGODB_URI=

# Optional contact placeholders (leave blank until verified)
CONTACT_PHONE=
CONTACT_EMAIL=
CONTACT_ADDRESS=
BUSINESS_HOURS=

# Uploads
MAX_RESUME_MB=5
