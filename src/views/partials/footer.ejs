<footer class="border-t border-green-dark/10 bg-white">
  <div class="site-container grid gap-10 py-16 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-display text-xl font-bold text-green-dark">PRANAM Consultancy</p>
      <p class="mt-3 text-sm leading-relaxed text-ink-muted">
        <%= site.legalName %> is a Mumbai-based HR and manpower consulting organisation supporting recruitment, staffing, payroll, and workforce requirements.
      </p>
    </div>
    <div>
      <p class="text-sm font-semibold text-ink">Company</p>
      <ul class="mt-4 space-y-2 text-sm text-ink-muted">
        <li><a class="hover:text-green-dark" href="/about">About Us</a></li>
        <li><a class="hover:text-green-dark" href="/services">Services</a></li>
        <li><a class="hover:text-green-dark" href="/industries">Industries</a></li>
        <li><a class="hover:text-green-dark" href="/careers">Careers</a></li>
      </ul>
    </div>
    <div>
      <p class="text-sm font-semibold text-ink">For You</p>
      <ul class="mt-4 space-y-2 text-sm text-ink-muted">
        <li><a class="hover:text-green-dark" href="/careers">Find a Job</a></li>
        <li><a class="hover:text-green-dark" href="/candidates">Submit Resume</a></li>
        <li><a class="hover:text-green-dark" href="/employers">Hire Talent</a></li>
        <li><a class="hover:text-green-dark" href="/contact">Contact Us</a></li>
      </ul>
    </div>
    <div>
      <p class="text-sm font-semibold text-ink">Connect</p>
      <ul class="mt-4 space-y-2 text-sm text-ink-muted">
        <% if (site.contact.linkedin) { %>
          <li><a class="hover:text-green-dark" href="<%= site.contact.linkedin %>">LinkedIn</a></li>
        <% } else { %>
          <li>LinkedIn — to be added</li>
        <% } %>
        <% if (site.contact.instagram) { %>
          <li><a class="hover:text-green-dark" href="<%= site.contact.instagram %>">Instagram</a></li>
        <% } else { %>
          <li>Instagram — to be added</li>
        <% } %>
        <li><%= site.contact.email ? site.contact.email : 'Email — to be added' %></li>
        <li><%= site.contact.phone ? site.contact.phone : 'Phone — to be added' %></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-green-dark/10">
    <div class="site-container flex flex-col gap-3 py-6 text-xs text-ink-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© <%= site.copyrightYear %> <%= site.legalName %>. All Rights Reserved.</p>
      <p class="flex gap-4">
        <a class="hover:text-green-dark" href="/privacy">Privacy Policy</a>
        <a class="hover:text-green-dark" href="/terms">Terms &amp; Conditions</a>
      </p>
    </div>
  </div>
</footer>
