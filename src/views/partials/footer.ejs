<footer class="border-t border-green-dark/10 bg-white">
  <div class="site-container grid gap-10 py-16 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-display text-xl font-bold text-green-dark">PRANAM Consultancy</p>
      <p class="mt-3 text-sm leading-relaxed text-ink-muted">
        <%= site.legalName %> is based in <%= site.officeArea %>, <%= site.city %>, and supports recruitment, staffing, payroll, and workforce requirements.
      </p>
    </div>
    <div>
      <p class="text-sm font-semibold text-ink">Company</p>
      <ul class="mt-4 space-y-2 text-sm text-ink-muted">
        <li><a class="hover:text-green-dark" href="/about">About Us</a></li>
        <li><a class="hover:text-green-dark" href="/services">Services</a></li>
        <li><a class="hover:text-green-dark" href="/industries">Industries</a></li>
        <li><a class="hover:text-green-dark" href="/careers">Careers</a></li>
      </ul>
    </div>
    <div>
      <p class="text-sm font-semibold text-ink">For You</p>
      <ul class="mt-4 space-y-2 text-sm text-ink-muted">
        <li><a class="hover:text-green-dark" href="/careers">Find a Job</a></li>
        <li><a class="hover:text-green-dark" href="/candidates">Submit Resume</a></li>
        <li><a class="hover:text-green-dark" href="/employers">Hire Talent</a></li>
        <li><a class="hover:text-green-dark" href="/contact">Contact Us</a></li>
      </ul>
    </div>
    <div>
      <p class="text-sm font-semibold text-ink">Connect</p>
      <ul class="mt-4 space-y-3 text-sm text-ink-muted">
        <li>
          <% if (site.contact.linkedin) { %>
            <a class="inline-flex items-center gap-2 hover:text-green-dark" href="<%= site.contact.linkedin %>" target="_blank" rel="noopener noreferrer">
              <%- include('./contact-icon', { name: 'linkedin' }) %><span>LinkedIn</span>
            </a>
          <% } else { %>
            <span class="inline-flex items-center gap-2"><%- include('./contact-icon', { name: 'linkedin' }) %><span>LinkedIn — to be added</span></span>
          <% } %>
        </li>
        <li>
          <% if (site.contact.instagram) { %>
            <a class="inline-flex items-center gap-2 hover:text-green-dark" href="<%= site.contact.instagram %>" target="_blank" rel="noopener noreferrer">
              <%- include('./contact-icon', { name: 'instagram' }) %><span>Instagram</span>
            </a>
          <% } else { %>
            <span class="inline-flex items-center gap-2"><%- include('./contact-icon', { name: 'instagram' }) %><span>Instagram — to be added</span></span>
          <% } %>
        </li>
        <li>
          <% if (site.contact.email) { %>
            <a class="inline-flex items-center gap-2 hover:text-green-dark" href="mailto:<%= site.contact.email %>">
              <%- include('./contact-icon', { name: 'email' }) %><span><%= site.contact.email %></span>
            </a>
          <% } else { %>
            <span class="inline-flex items-center gap-2"><%- include('./contact-icon', { name: 'email' }) %><span>Email — to be added</span></span>
          <% } %>
        </li>
        <li>
          <% if (site.contact.phone) { %>
            <a class="inline-flex items-center gap-2 hover:text-green-dark" href="tel:<%= site.contact.phone.replace(/[^+\d]/g, '') %>">
              <%- include('./contact-icon', { name: 'phone' }) %><span><%= site.contact.phone %></span>
            </a>
          <% } else { %>
            <span class="inline-flex items-center gap-2"><%- include('./contact-icon', { name: 'phone' }) %><span>Phone — to be added</span></span>
          <% } %>
        </li>
      </ul>
    </div>
  </div>
  <div class="border-t border-green-dark/10">
    <div class="site-container flex flex-col gap-3 py-6 text-xs text-ink-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© <%= site.copyrightYear %> <%= site.legalName %>. All Rights Reserved.</p>
      <p class="flex gap-4">
        <a class="hover:text-green-dark" href="/privacy">Privacy Policy</a>
        <a class="hover:text-green-dark" href="/terms">Terms &amp; Conditions</a>
      </p>
    </div>
  </div>
</footer>
