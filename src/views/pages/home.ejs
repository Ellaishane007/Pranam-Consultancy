<section class="hero-wash overflow-hidden">
  <div class="site-container grid items-center gap-12 py-16 lg:grid-cols-2 lg:py-24">
    <div class="reveal">
      <p class="eyebrow">HR &amp; Manpower Consulting · Mumbai</p>
      <h1 class="display mt-4 max-w-xl">Connecting Exceptional Talent With Exceptional Opportunities</h1>
      <p class="lede mt-5">
        PRANAM Consultancy helps businesses find the right people and helps professionals discover meaningful career opportunities through reliable manpower and HR solutions.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn-primary" href="/candidates">Find a Job</a>
        <a class="btn-secondary" href="/employers">Hire Talent</a>
      </div>
      <ul class="mt-10 grid grid-cols-2 gap-3 text-sm text-ink-muted sm:grid-cols-4">
        <li class="rounded-2xl bg-white/80 px-3 py-3">10+ Years of Experience</li>
        <li class="rounded-2xl bg-white/80 px-3 py-3">Pan-India Workforce Solutions</li>
        <li class="rounded-2xl bg-white/80 px-3 py-3">Skilled &amp; Reliable Talent</li>
        <li class="rounded-2xl bg-white/80 px-3 py-3">Client-Focused Service</li>
      </ul>
    </div>
    <div class="relative reveal reveal-delay-2">
      <div class="absolute -left-8 -top-8 h-40 w-40 rounded-full bg-green-light/40 blur-3xl"></div>
      <div class="absolute -bottom-10 -right-6 h-48 w-48 rounded-full bg-green-fresh/25 blur-3xl"></div>
      <div class="image-frame relative z-10 h-[420px] w-full rounded-[1.75rem] shadow-card">
        <img
          src="https://images.unsplash.com/photo-1573497491208-6b1acb260507?auto=format&fit=crop&w=1200&q=80"
          alt="Professionals in a discussion during a workplace meeting"
          width="1200"
          height="840"
        />
      </div>
    </div>
  </div>
</section>

<section class="section bg-white" id="about-pranam">
  <div class="site-container grid items-center gap-12 lg:grid-cols-2">
    <div class="relative">
      <div class="image-frame h-[420px] w-full rounded-card">
        <img
          src="https://images.unsplash.com/photo-1521737604893-d14cc237f11d?auto=format&fit=crop&w=1100&q=80"
          alt="Collaborative team working together in a bright office"
        />
      </div>
      <div class="glass absolute -bottom-6 left-6 rounded-2xl px-5 py-4 shadow-card">
        <p class="text-xs uppercase tracking-widest text-ink-muted">Established</p>
        <p class="font-display text-2xl font-semibold text-green-dark">Since 2026</p>
      </div>
    </div>
    <div>
      <p class="eyebrow">About PRANAM</p>
      <h2 class="display mt-3">People. Opportunities. Growth.</h2>
      <p class="mt-5 text-ink-muted leading-relaxed">
        <%= site.legalName %> is an HR and manpower consulting organisation based in <%= site.officeArea %>, <%= site.city %>, founded around <%= site.foundedYear %> by <%= site.founder %> and <%= site.coFounder %>. We support recruitment, staffing, payroll, compliance, and workforce requirements with equal care for people and business outcomes.
      </p>
      <ul class="mt-8 space-y-5">
        <li>
          <p class="font-semibold text-ink">People First</p>
          <p class="text-sm text-ink-muted">We focus on understanding both organizational requirements and candidate aspirations.</p>
        </li>
        <li>
          <p class="font-semibold text-ink">Reliable Workforce Solutions</p>
          <p class="text-sm text-ink-muted">We help businesses access skilled, semi-skilled, and workforce talent across different requirements.</p>
        </li>
        <li>
          <p class="font-semibold text-ink">Long-Term Partnerships</p>
          <p class="text-sm text-ink-muted">Our approach focuses on building dependable relationships with clients and candidates.</p>
        </li>
      </ul>
      <a class="btn-primary mt-8" href="/about">Learn More About Us →</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="site-container">
    <p class="eyebrow">What we do</p>
    <h2 class="display mt-3">Our HR &amp; Workforce Solutions</h2>
    <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      <% site.services.forEach((service) => { %>
        <article class="card-hover">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-2xl bg-surface-mint text-green-dark">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="10" cy="10" r="7"/><path d="M10 6v8M6 10h8"/></svg>
          </div>
          <h3 class="font-display text-xl font-semibold"><%= service.title %></h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-muted"><%= service.summary %></p>
          <a class="mt-5 inline-flex text-sm font-semibold text-green-dark" href="/services#<%= service.slug %>">Explore Service →</a>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<section class="section bg-white">
  <div class="site-container">
    <p class="eyebrow">Why PRANAM</p>
    <h2 class="display mt-3">Why Businesses Choose PRANAM</h2>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <% site.reasons.forEach((item) => { %>
        <article class="card-hover">
          <h3 class="font-display text-lg font-semibold"><%= item.title %></h3>
          <p class="mt-2 text-sm text-ink-muted"><%= item.text %></p>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<section class="section">
  <div class="site-container">
    <p class="eyebrow">Industries</p>
    <h2 class="display mt-3">Workforce Solutions Across Industries</h2>
    <p class="lede mt-4">From frontline workforce requirements to specialized professional hiring, we help organizations build teams suited to their operational needs.</p>
    <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
      <% site.industries.forEach((industry) => { %>
        <a href="/industries" class="card-hover flex min-h-[7rem] items-center justify-center text-center text-sm font-semibold">
          <%= industry %>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<section class="section bg-white">
  <div class="site-container grid items-center gap-10 lg:grid-cols-2">
    <div>
      <p class="eyebrow">Candidates</p>
      <h2 class="display mt-3">Your Next Opportunity Could Start Here</h2>
      <p class="lede mt-4">Looking for your next career move? Explore opportunities and connect with our recruitment team.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn-primary" href="/careers">Explore Jobs</a>
        <a class="btn-secondary" href="/candidates">Submit Your Resume</a>
      </div>
    </div>
    <div class="image-frame h-80 w-full rounded-card">
      <img
        src="https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=1100&q=80"
        alt="Candidate speaking with a recruiter in a professional setting"
      />
    </div>
  </div>
</section>

<section class="section">
  <div class="site-container grid items-center gap-10 lg:grid-cols-2">
    <div class="image-frame order-2 h-80 w-full rounded-card lg:order-1">
      <img
        src="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?auto=format&fit=crop&w=1100&q=80"
        alt="Business colleagues reviewing hiring plans together"
      />
    </div>
    <div class="order-1 lg:order-2">
      <p class="eyebrow">Employers</p>
      <h2 class="display mt-3">Need the Right People for Your Business?</h2>
      <p class="lede mt-4">Tell us what your organization needs, and our recruitment team can help you explore a suitable workforce solution.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn-primary" href="/employers">Request Manpower</a>
        <a class="btn-secondary" href="/contact">Talk to Our Team</a>
      </div>
    </div>
  </div>
</section>

<section class="section bg-white">
  <div class="site-container">
    <p class="eyebrow">How we work</p>
    <h2 class="display mt-3">Recruitment Process</h2>
    <ol class="mt-12 grid gap-6 lg:grid-cols-6">
      <% site.process.forEach((item, index) => { %>
        <li class="relative text-center">
          <% if (index < site.process.length - 1) { %>
            <span class="process-line absolute left-1/2 top-5 hidden h-0.5 w-full lg:block" aria-hidden="true"></span>
          <% } %>
          <span class="relative z-10 mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-green-dark text-sm font-semibold text-white"><%= item.step %></span>
          <h3 class="mt-4 font-display font-semibold"><%= item.title %></h3>
          <p class="mt-2 text-sm text-ink-muted"><%= item.text %></p>
        </li>
      <% }) %>
    </ol>
  </div>
</section>

<section class="section">
  <div class="site-container grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    <div class="card text-center">
      <p class="font-display text-3xl font-semibold text-green-dark">2026</p>
      <p class="mt-1 text-sm text-ink-muted">Founded</p>
    </div>
    <div class="card text-center">
      <p class="font-display text-3xl font-semibold text-green-dark">Mumbai</p>
      <p class="mt-1 text-sm text-ink-muted">Headquarters</p>
    </div>
    <div class="card text-center">
      <p class="font-display text-3xl font-semibold text-green-dark">Multiple</p>
      <p class="mt-1 text-sm text-ink-muted">Workforce Solutions</p>
    </div>
    <div class="card text-center">
      <p class="font-display text-3xl font-semibold text-green-dark">Pan-India</p>
      <p class="mt-1 text-sm text-ink-muted">Service Capability</p>
    </div>
  </div>
</section>

<section class="section bg-white">
  <div class="site-container">
    <p class="eyebrow">Leadership</p>
    <h2 class="display mt-3">Meet our founders</h2>
    <p class="mt-5 max-w-3xl leading-relaxed text-ink-muted">
      Prashant Chavan, Founder, and Poonam Phatak Chavan, Co-Founder, lead PRANAM Consultancy in supporting practical workforce needs across Mumbai and India.
    </p>
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      <% site.founders.forEach((person) => { %>
        <article class="card grid gap-6 sm:grid-cols-[minmax(0,0.8fr)_minmax(0,1fr)] sm:items-center">
          <div class="image-frame aspect-[4/5] w-full rounded-card">
            <img
              src="<%= person.image %>"
              alt="Illustrative portrait of <%= person.name %>"
              loading="lazy"
            />
          </div>
          <div>
            <p class="eyebrow"><%= person.title %></p>
            <h3 class="mt-2 font-display text-2xl font-semibold text-ink"><%= person.name %></h3>
            <p class="mt-3 text-sm text-ink-muted"><%= site.legalName %></p>
          </div>
        </article>
      <% }); %>
    </div>
    <div class="mt-8 max-w-3xl">
      <blockquote class="mt-8 border-l-2 border-green-light pl-5 text-lg font-display text-ink">
        “The right people can transform the way a business grows.”
        <footer class="mt-2 text-sm text-ink-muted">Brand statement for PRANAM Consultancy — not a verified public quotation.</footer>
      </blockquote>
    </div>
  </div>
</section>

<section class="section">
  <div class="site-container grid items-center gap-10 lg:grid-cols-2">
    <div>
      <h2 class="display">Rooted in Mumbai. Connected to Opportunity.</h2>
      <p class="lede mt-4">
        Our work begins in Goregaon West, Mumbai, Maharashtra, India — a city that moves on people, enterprise, and ambition. From this base we support workforce requirements with a pan-India service capability.
      </p>
    </div>
    <div class="relative overflow-hidden rounded-card bg-green-dark p-10 text-white">
      <p class="text-sm uppercase tracking-[0.2em] text-green-light">Location</p>
      <p class="mt-4 font-display text-3xl font-semibold"><%= site.officeArea %></p>
      <p class="mt-2 text-white/75"><%= site.city %>, <%= site.state %>, <%= site.country %></p>
    </div>
  </div>
</section>

<section class="section bg-white">
  <div class="site-container">
    <p class="eyebrow">Our clients</p>
    <h2 class="display mt-3">Organisations We Work With</h2>
    <p class="lede mt-4">We currently work with these organisations to support their workforce requirements.</p>
    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      <% ['SB Fab', 'Nirmal Enterprises'].forEach((client) => { %>
        <div class="card flex min-h-32 items-center justify-center text-center">
          <h3 class="font-display text-2xl font-semibold text-green-dark"><%= client %></h3>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<%- include('../partials/cta') %>
