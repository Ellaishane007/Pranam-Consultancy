<section class="bg-white">
  <div class="site-container section max-w-3xl">
    <p class="text-xs font-semibold uppercase tracking-widest text-green-fresh">Demo listing — not a live vacancy</p>
    <h1 class="display mt-3"><%= job.title %></h1>
    <p class="mt-3 text-ink-muted"><%= job.company %> · <%= job.location %></p>
    <ul class="mt-6 flex flex-wrap gap-2 text-sm">
      <li class="rounded-full bg-surface-mint px-3 py-1"><%= job.employmentType %></li>
      <li class="rounded-full bg-surface-mint px-3 py-1"><%= job.experience %></li>
      <li class="rounded-full bg-surface-mint px-3 py-1"><%= job.category %></li>
    </ul>
    <p class="mt-8 leading-relaxed text-ink-muted"><%= job.excerpt %></p>
    <p class="mt-4 text-sm text-ink-muted">Posted <%= job.postedDate %>. Client identity is withheld because this is sample content.</p>
    <div class="mt-8 flex gap-3">
      <a class="btn-primary" href="/candidates">Apply Now</a>
      <a class="btn-secondary" href="/careers">Back to listings</a>
    </div>
  </div>
</section>
