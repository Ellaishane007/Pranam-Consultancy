<section class="bg-white">
  <div class="site-container section">
    <p class="eyebrow">Services</p>
    <h1 class="display mt-3">HR &amp; workforce solutions</h1>
    <p class="lede mt-4">Five core offerings designed to support hiring, operations, and compliance without overstatement.</p>
  </div>
</section>

<section class="section">
  <div class="site-container space-y-6">
    <% site.services.forEach((service) => { %>
      <article id="<%= service.slug %>" class="card scroll-mt-28">
        <h2 class="font-display text-2xl font-semibold"><%= service.title %></h2>
        <p class="mt-3 max-w-3xl text-ink-muted"><%= service.summary %></p>
        <a class="mt-5 inline-flex text-sm font-semibold text-green-dark" href="/contact">Discuss this service →</a>
      </article>
    <% }) %>
  </div>
</section>
