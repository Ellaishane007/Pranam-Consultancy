<section class="bg-white">
  <div class="site-container section grid gap-12 lg:grid-cols-2">
    <div>
      <p class="eyebrow">Candidates</p>
      <h1 class="display mt-3">Your next opportunity could start here</h1>
      <p class="lede mt-4">Looking for your next career move? Explore opportunities and connect with our recruitment team. Resumes are stored securely and are not published on this website.</p>
      <div class="mt-8 flex gap-3">
        <a class="btn-primary" href="/careers">Explore Jobs</a>
        <a class="btn-secondary" href="#apply">Submit Your Resume</a>
      </div>
    </div>
    <img
      src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=1100&q=80"
      alt="Professionals collaborating around a table"
      class="h-80 w-full rounded-card object-cover"
    />
  </div>
</section>

<section id="apply" class="section">
  <div class="site-container max-w-3xl">
    <h2 class="display">Submit your profile</h2>
    <%- include('../partials/flash') %>
    <form class="mt-8 grid gap-4" method="post" action="/api/job-application" enctype="multipart/form-data" data-form novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <p class="hidden" aria-hidden="true"><label>Company website <input name="company_website" tabindex="-1" autocomplete="off" /></label></p>
      <div>
        <label class="label" for="fullName">Full name</label>
        <input class="field" id="fullName" name="fullName" required minlength="2" autocomplete="name" />
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class="label" for="email">Email</label>
          <input class="field" id="email" name="email" type="email" required autocomplete="email" />
        </div>
        <div>
          <label class="label" for="phone">Phone number</label>
          <input class="field" id="phone" name="phone" type="tel" required autocomplete="tel" />
        </div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class="label" for="location">Location</label>
          <input class="field" id="location" name="location" required />
        </div>
        <div>
          <label class="label" for="preferredRole">Preferred job role</label>
          <input class="field" id="preferredRole" name="preferredRole" required />
        </div>
      </div>
      <div>
        <label class="label" for="experience">Experience</label>
        <input class="field" id="experience" name="experience" required placeholder="e.g. 3 years in retail operations" />
      </div>
      <div>
        <label class="label" for="resume">Resume (PDF, DOC, or DOCX)</label>
        <input class="field bg-white" id="resume" name="resume" type="file" required accept=".pdf,.doc,.docx,application/pdf" />
      </div>
      <div>
        <label class="label" for="message">Message</label>
        <textarea class="field min-h-[7rem]" id="message" name="message"></textarea>
      </div>
      <button class="btn-primary justify-self-start" type="submit">Submit Application</button>
      <p class="text-sm" data-form-status></p>
    </form>
  </div>
</section>
